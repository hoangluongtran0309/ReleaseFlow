<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.hoangluongtran0309</groupId>
    <artifactId>releaseflow</artifactId>
    <!-- The version is never written here. A release takes it from its tag: the Release
         workflow builds with -Drevision=<tag without the v>. See ADR-0030. -->
    <version>${revision}</version>
    <name>ReleaseFlow</name>
    <description>Human-reviewed release notes, written for each audience and delivered where they are read.</description>
    <url>https://github.com/hoangluongtran0309/ReleaseFlow</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>hoangluongtran0309</id>
            <name>Luong Tran Chu Hoang</name>
            <url>https://github.com/hoangluongtran0309</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/hoangluongtran0309/ReleaseFlow.git</connection>
        <developerConnection>scm:git:git@github.com:hoangluongtran0309/ReleaseFlow.git</developerConnection>
        <url>https://github.com/hoangluongtran0309/ReleaseFlow</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/hoangluongtran0309/ReleaseFlow/issues</url>
    </issueManagement>

    <properties>
        <!-- What a local or CI build calls itself. Nothing edits it, and no release
             carries it: the Release workflow refuses a tag without a CHANGELOG entry
             and builds that tag with -Drevision set. -->
        <revision>0.0.0-SNAPSHOT</revision>
        <java.version>21</java.version>
        <!-- Overrides of versions the Spring Boot parent manages. Each one is listed in
             scripts/ci/check-version-overrides.sh, which fails CI once the parent
             manages the same version or a newer one, so an override can never quietly
             hold a dependency back after a Boot upgrade. -->
        <!-- Spring Boot 4.1.1 manages Tomcat 11.0.24, which has critical CVEs
             (CVE-2026-65182, CVE-2026-65905, CVE-2026-68525). Remove this
             override once the parent manages 11.0.25 or later. -->
        <tomcat.version>11.0.25</tomcat.version>
        <!-- Spring Boot 4.1.1 manages Jackson 3.1.5 and 2.21.5. Those, and 3.1.6 and 2.21.6
             after them, have high CVEs in jackson-core and jackson-databind
             (CVE-2026-68497, CVE-2026-89407, CVE-2026-89425, CVE-2026-91776,
             CVE-2026-91777). Remove these overrides once the parent manages 3.1.7 and
             2.21.7 or later. -->
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <alpinejs.version>3.17.4</alpinejs.version>
        <anthropic-java.version>3.1.0</anthropic-java.version>
        <commonmark.version>0.30.1</commonmark.version>
        <frontend-maven-plugin.version>2.0.2</frontend-maven-plugin.version>
        <frontend-maven-plugin.nodeVersion>v22.22.3</frontend-maven-plugin.nodeVersion>
        <frontend-maven-plugin.npmVersion>10.9.8</frontend-maven-plugin.npmVersion>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>nz.net.ultraq.thymeleaf</groupId>
            <artifactId>thymeleaf-layout-dialect</artifactId>
        </dependency>
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>webjars-locator-lite</artifactId>
        </dependency>
        <dependency>
            <groupId>org.webjars.npm</groupId>
            <artifactId>alpinejs</artifactId>
            <version>${alpinejs.version}</version>
            <!-- The webjar asks for vue__reactivity by the range [3.1.1,3.2.0-0), which
                 resolves to a beta and moves whenever one is published. The pages load
                 dist/cdn.min.js, which bundles its own reactivity, so nothing uses it. -->
            <exclusions>
                <exclusion>
                    <groupId>org.webjars.npm</groupId>
                    <artifactId>vue__reactivity</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>com.anthropic</groupId>
            <artifactId>anthropic-java</artifactId>
            <version>${anthropic-java.version}</version>
        </dependency>
        <dependency>
            <groupId>com.samskivert</groupId>
            <artifactId>jmustache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>${commonmark.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>releaseflow</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- Tailwind compiles this stylesheet into target/classes; copying
                     the source would overwrite the generated file. -->
                <excludes>
                    <exclude>static/css/application.css</exclude>
                </excludes>
            </resource>
            <!-- Apache-2.0 §4.4: the licence and the notice travel with the artifact,
                 so somebody who has only the JAR still has both. -->
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- Fails the build, before anything compiles, on a dependency graph that
                 would not build the same way twice or that hides a downgrade. The
                 parent manages the plugin's version. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-and-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!-- The wrapper's Maven and the JDK the code is written for. -->
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <requireJavaVersion>
                                    <version>[${java.version},)</version>
                                </requireJavaVersion>
                                <!-- No version range, LATEST, RELEASE, or SNAPSHOT anywhere in
                                     the graph, transitive ones included: each would let a
                                     publication somebody else makes change this build. -->
                                <banDynamicVersions/>
                                <!-- No dependency resolved below what something else asks for,
                                     and no two versions of one artifact in the graph. -->
                                <requireUpperBoundDeps/>
                                <dependencyConvergence/>
                                <banDuplicatePomDependencyVersions/>
                                <!-- Every plugin that runs has a version from this POM or the
                                     parent, never from Maven's defaults. The site lifecycle
                                     never runs here. -->
                                <requirePluginVersions>
                                    <unCheckedPluginList>org.apache.maven.plugins:maven-site-plugin</unCheckedPluginList>
                                </requirePluginVersions>
                                <!-- Logging goes through SLF4J and Logback, and tests use
                                     JUnit 5. Log4j 1.x is unmaintained and has unfixed CVEs;
                                     JUnit 4 would be a second, unmanaged test engine. -->
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>log4j:log4j</exclude>
                                        <exclude>junit:junit</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <installDirectory>${project.basedir}</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-frontend-tooling</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${frontend-maven-plugin.nodeVersion}</nodeVersion>
                            <npmVersion>${frontend-maven-plugin.npmVersion}</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>run-npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>run-npm-build</id>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>run build-prod</arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
